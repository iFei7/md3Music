<?xml version="1.0" encoding="utf-8"?>
<!-- 用 Lyrico 外部编辑本地歌曲：允许 FileProvider 暴露整个外部存储根路径，
     本地音乐文件可能位于任意目录（Download / Music / 自定义目录等）。 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="external" path="."/>
    <!-- 应用内更新：APK 下载到 cacheDir/update_apk/，经 FileProvider 授权给
         系统安装器读取（与 InAppUpdater._cacheDirName 保持一致） -->
    <cache-path name="update_apk" path="update_apk/" />
</paths>
