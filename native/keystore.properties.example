# keystore.properties 示例模板，可安全提交；本文件不含任何真实凭证。
#
# 使用方法：
# 1) 复制本文件为 keystore.properties，填入真实值。keystore.properties 已被
#    .gitignore 覆盖，不会入库，仅用于本地 release 签名。
# 2) storeFile 指向 .jks / .keystore 密钥库文件，填绝对或相对路径均可；
#    密钥库本体同样被 .gitignore 覆盖，建议放在仓库外（如本地专用目录），
#    不要为了图省事拷进 native/ 目录再靠 gitignore 兜底。
# 3) CI 中无需提交本文件：在 GitHub Secrets 配置 ANDROID_KEYSTORE_BASE64
#    （密钥库 base64 内容）/ ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS /
#    ANDROID_KEY_PASSWORD，由工作流解码注入，与本地 keystore.properties
#    机制等价（优先级见 app/build.gradle.kts 的 signingValue）。
#
# 安全警示：storePassword / keyPassword 为明文口令，泄露等于泄露应用签名
# 私钥；真实口令、私钥、密钥库文件**严禁提交 Git**，也不要贴进 issue、PR、
# 聊天记录或任何外部渠道。

# 密钥库文件路径（.jks / .keystore，绝对或相对路径，建议放仓库外）
storeFile=CHANGE_ME_TO_YOUR_KEYSTORE_PATH.jks

# 密钥库口令（打开 .jks/.keystore 所需）
storePassword=CHANGE_ME

# 签名密钥别名（keytool -genkeypair 时指定的 -alias）
keyAlias=CHANGE_ME

# 签名密钥口令（使用该别名签名所需，可与 storePassword 相同）
keyPassword=CHANGE_ME
